{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2022"],
		"types": ["node"],
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "dist"
	}
}
